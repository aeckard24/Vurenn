# Public URL of Andrew's Python API. Required only when backend mode is enabled.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Public Supabase project values. Configure both together when authentication
# is connected. The anon key is browser-safe; never put a service-role key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# false keeps the lightweight local frontend adapters active.
# true selects HTTP chat, conversation, and model services with no mock fallback.
NEXT_PUBLIC_VURENN_BACKEND_ENABLED=false
